# ============================================================
# Neon Warm Backend — Variáveis de ambiente
# Copie para .env.local (dev) ou configure no Vercel (prod).
# NUNCA commite valores reais.
# ============================================================

# --- Supabase (banco) ---
# Usadas APENAS no servidor (API Routes / admin). Nunca vão para o frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Identificação da extensão ---
# ID exato da extensão Chrome Neon Warm (do manifest.json).
NEON_WARM_EXTENSION_ID=neon-warm-extension

# --- CORS ---
# Origens permitidas, separadas por vírgula. Para extensão Chrome:
# chrome-extension://<extension_id>
# Em dev local: http://localhost:3000
NEON_WARM_ALLOWED_ORIGIN=chrome-extension://SEU_ID_AQUI

# --- Rate limiting ---
# Limite de requisições por janela de tempo (por extensão + IP + rota).
NEON_WARM_RATE_LIMIT=60
NEON_WARM_RATE_WINDOW_SECONDS=60

# --- Painel administrativo (cookie assinado) ---
# Credenciais do admin. A senha é comparada no servidor com timing-safe.
NEON_WARM_ADMIN_EMAIL=admin@exemplo.com
NEON_WARM_ADMIN_PASSWORD=troque-esta-senha
NEON_WARM_ADMIN_SECRET=um-segredo-longo-e-aleatorio-para-assinar-o-cookie

# --- Opcional: chave anon do Supabase ---
# Necessária APENAS se no futuro o frontend usar supabase-js no cliente.
# NÃO é usada pelas API Routes (que usam service role no servidor).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
